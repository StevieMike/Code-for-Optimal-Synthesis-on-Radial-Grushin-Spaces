    "Covectors" -> MakePair[1/3, 2/3]|>, <|
    "Label" -> "K = 0, family 1", "Covectors" -> MakePair[0, 1/2]|>, <|
    "Label" -> "K = 0, family 2", 
    "Covectors" -> MakePair[0, 3/4]|>,(*Noncircular L=
   0 example*)<|"Label" -> "L = 0", "Covectors" -> {{0, 4/5, 3/5}}|>};
