ClearAll[FamilyPlot];

FamilyPlot[alpha_, covectors_, color_] := 
  Module[{data, curves, endpoint}, 
   data = GeodesicSolution[alpha, #] & /@ covectors;
   curves = 
    MapIndexed[
     Function[{g, j}, 
      Module[{style, pos, P}, 
       style = If[First[j] == 1, Directive[color, Thick], 
         Directive[color, Thick, Dashed]];
       pos = g["Position"];
       P = g["Period"];
       ParametricPlot3D[Evaluate[pos[t]], {t, 0, P}, 
        PlotStyle -> style, PlotPoints -> 150, MaxRecursion -> 3, 
        PlotRange -> All]]], data];
   endpoint = With[{g = First[data]}, g["Position"][g["Period"]]];
   Show[curves, Graphics3D[{color, PointSize[0.014], Point[endpoint]}]]];



