    RowBox[{"cov", ":", 
     RowBox[{"{", 
      RowBox[{"L_", ",", "K_", ",", "w_"}], "}"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"ll", "=", 
       RowBox[{"N", "[", "L", "]"}]}], ",", 
      RowBox[{"kk", "=", 
       RowBox[{"N", "[", "K", "]"}]}], ",", 
      RowBox[{"ww", "=", 
       RowBox[{"N", "[", "w", "]"}]}], ",", "P", ",", "sol"}], "}"}], ",", 
    RowBox[{
     RowBox[{"P", "=", 
      RowBox[{"PAlpha", "[", 
       RowBox[{"alpha", ",", "cov"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", "kk", "]"}], "<", "tol"}], ",", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"x", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"px", "[", "t", "]"}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"px", "'"}], "[", "t", "]"}], "==", 
              RowBox[{
               RowBox[{"-", "alpha"}], " ", 
               RowBox[{"ww", "^", "2"}], " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "[", "t", "]"}], "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", " ", "alpha"}], "-", "2"}], ")"}]}], " ", 
               RowBox[{"x", "[", "t", "]"}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"ww", " ", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"x", "[", "t", "]"}], "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "alpha"}], ")"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"x", "[", "0", "]"}], "==", "1"}], ",", 
             RowBox[{
              RowBox[{"px", "[", "0", "]"}], "==", "ll"}], ",", 
             RowBox[{
              RowBox[{"z", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "px", ",", "z"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "P"}], "}"}], ",", 
           RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Period\>\"", "->", "P"}], ",", 
          RowBox[{"\"\<Position\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "tt", "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"sol", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", "tt", "]"}], ",", "0", ",", 
               RowBox[{
                RowBox[{"sol", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "[", "tt", "]"}]}], "}"}]}], 
            "]"}]}]}], "|>"}]}], ",", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"NDSolveValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"r", "'"}], "[", "t", "]"}], "==", 
