 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "FamilyPlot", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FamilyPlot", "[", 
    RowBox[{"alpha_", ",", "covectors_", ",", "color_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"data", ",", "curves", ",", "endpoint"}], "}"}], ",", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"GeodesicSolution", "[", 
          RowBox[{"alpha", ",", "#"}], "]"}], "&"}], "/@", "covectors"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"curves", "=", 
       RowBox[{"MapIndexed", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"g", ",", "j"}], "}"}], ",", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"style", ",", "pos", ",", "P"}], "}"}], ",", 
             RowBox[{
              RowBox[{"style", "=", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"First", "[", "j", "]"}], "==", "1"}], ",", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"color", ",", "Thick"}], "]"}], ",", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"color", ",", "Thick", ",", "Dashed"}], "]"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"pos", "=", 
               RowBox[{"g", "[", "\"\<Position\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"P", "=", 
               RowBox[{"g", "[", "\"\<Period\>\"", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"ParametricPlot3D", "[", 
               RowBox[{
                RowBox[{"Evaluate", "[", 
                 RowBox[{"pos", "[", "t", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", "0", ",", "P"}], "}"}], ",", 
                RowBox[{"PlotStyle", "->", "style"}], ",", 
                RowBox[{"PlotPoints", "->", "150"}], ",", 
                RowBox[{"MaxRecursion", "->", "3"}], ",", 
                RowBox[{"PlotRange", "->", "All"}]}], "]"}]}]}], "]"}]}], 
          "]"}], ",", "data"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"endpoint", "=", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"g", "=", 
           RowBox[{"First", "[", "data", "]"}]}], "}"}], ",", 
         RowBox[{
