Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "PAlpha", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PAlpha", "[", 
    RowBox[{
     RowBox[{"alpha_", "?", "NumericQ"}], ",", 
     RowBox[{"cov", ":", 
      RowBox[{"{", 
       RowBox[{"L_", ",", "K_", ",", "w_"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kk", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", "K", "]"}], "]"}]}], ",", 
       RowBox[{"ww", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", "w", "]"}], "]"}]}], ",", "rm", ",", "rp", ",", 
       "d", ",", "q", ",", "qp", ",", "g"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ww", "<", "tol"}], ",", 
        RowBox[{"Return", "[", "Infinity", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"kk", "<", "tol"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"PiAlpha", "[", "alpha", "]"}], " ", 
           RowBox[{"ww", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "alpha"}], ")"}]}]}], "]"}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rm", ",", "rp"}], "}"}], "=", 
       RowBox[{"TurningRadii", "[", 
        RowBox[{"alpha", ",", "cov"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Circular", " ", "limiting", " ", "radial", " ", "period"}], 
       "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"rp", "-", "rm"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"N", "[", 
          RowBox[{"2", " ", 
           RowBox[{"Pi", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"2", " ", "alpha"}], "]"}]}]}], "]"}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{"rp", "-", "rm"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"kk", "^", "2"}], "/", 
         RowBox[{"r", "^", "2"}]}], "-", 
        RowBox[{
         RowBox[{"ww", "^", "2"}], " ", 
         RowBox[{"r", "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", "alpha"}], ")"}]}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"qp", "[", 
        RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{
          RowBox[{"kk", "^", "2"}], "/", 
          RowBox[{"r", "^", "3"}]}]}], "-", 
        RowBox[{"2", " ", "alpha", " ", 
         RowBox[{"ww", "^", "2"}], " ", 
         RowBox[{"r", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "alpha"}], "-", "1"}], ")"}]}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"u_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "u", "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"d", "/", 
            RowBox[{"qp", "[", "rm", "]"}]}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"u", "-", 
            RowBox[{"Pi", "/", "2"}]}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "8"}]}]}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"d", "/", 
            RowBox[{"(", 
             RowBox[{"-", 
              RowBox[{"qp", "[", "rp", "]"}]}], ")"}]}], "]"}]}], ",", "True",
          ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r", "=", 
             RowBox[{"rm", "+", 
              RowBox[{"d", " ", 
               RowBox[{
                RowBox[{"Sin", "[", "u", "]"}], "^", "2"}]}]}]}], "}"}], ",", 
           
           RowBox[{"2", " ", "d", " ", 
            RowBox[{"Sin", "[", "u", "]"}], " ", 
            RowBox[{
             RowBox[{"Cos", "[", "u", "]"}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Max", "[", 
               RowBox[{
                RowBox[{"q", "[", "r", "]"}], ",", "0."}], "]"}], "]"}]}]}]}],
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"2", " ", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{"g", "[", "u", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", "0", ",", 
           RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
         RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}], ",", 
         RowBox[{"AccuracyGoal", "->", "10"}], ",", 
         RowBox[{"PrecisionGoal", "->", "10"}]}], "]"}]}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998356563432749*^9, 3.998356563432913*^9}, 
   3.998356965094363*^9},
