              RowBox[{
               RowBox[{
                RowBox[{"kk", "^", "2"}], "/", 
                RowBox[{
                 RowBox[{"r", "[", "t", "]"}], "^", "3"}]}], "-", 
               RowBox[{"alpha", " ", 
                RowBox[{"ww", "^", "2"}], " ", 
                RowBox[{
                 RowBox[{"r", "[", "t", "]"}], "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", " ", "alpha"}], "-", "1"}], ")"}]}]}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"th", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"kk", "/", 
               RowBox[{
                RowBox[{"r", "[", "t", "]"}], "^", "2"}]}]}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"z", "'"}], "[", "t", "]"}], "==", 
              RowBox[{"ww", " ", 
               RowBox[{
                RowBox[{"r", "[", "t", "]"}], "^", 
                RowBox[{"(", 
                 RowBox[{"2", " ", "alpha"}], ")"}]}]}]}], ",", 
             RowBox[{
              RowBox[{"r", "[", "0", "]"}], "==", "1"}], ",", 
             RowBox[{
              RowBox[{"pr", "[", "0", "]"}], "==", "ll"}], ",", 
             RowBox[{
              RowBox[{"th", "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{"z", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "pr", ",", "th", ",", "z"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "P"}], "}"}], ",", 
           RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Period\>\"", "->", "P"}], ",", 
          RowBox[{"\"\<Position\>\"", "->", 
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "tt", "}"}], ",", 
