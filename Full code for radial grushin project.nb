       RowBox[{"Flatten", "[", "sNames", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tmax", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"93", "/", "25"}], ",", "wp"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"stateEq", ",", "stateIC", ",", "sensEq", ",", "sensIC"}], 
        "]"}], ",", "depVars", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
       RowBox[{"WorkingPrecision", "->", "wp"}], ",", 
       RowBox[{"AccuracyGoal", "->", "30"}], ",", 
       RowBox[{"PrecisionGoal", "->", "30"}], ",", 
       RowBox[{"MaxStepSize", "->", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"1", "/", "2000"}], ",", "wp"}], "]"}]}], ",", 
       RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "first", " ", "six", " ", "entries", " ", "are", " ", "the", 
      " ", "Hamiltonian", " ", 
      RowBox[{"variables", ".", "Entries"}], " ", "7"}], ",", "...", ",", 
     RowBox[{"24", " ", "are", " ", "the", " ", "sensitivity", " ", 
      RowBox[{"matrix", "."}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sSol", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"sol", "[", 
        RowBox[{"[", 
         RowBox[{"7", ";;", "24"}], "]"}], "]"}], ",", "3"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Snum", "[", 
      RowBox[{"tt_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "tt", "]"}], "&"}], ",", "sSol", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"endpoint", " ", "differential", " ", "d", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", ",", "y", ",", "z"}], ")"}], "/", "d"}], 
     RowBox[{"(", 
      RowBox[{"L", ",", "K", ",", "w"}], ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"endpointJac", "[", 
      RowBox[{"tt_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Snum", "[", "tt", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"1", ";;", "3"}], ",", "All"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"detEnd", "[", 
      RowBox[{"tt_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"Det", "[", 
      RowBox[{"endpointJac", "[", "tt", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5.", " ", "Locate", " ", "the", " ", "first", " ", "transverse", " ", 
     "zero"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"grid", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"1", "/", "100"}], ",", 
         RowBox[{"P", "-", 
          RowBox[{"1", "/", "10000"}]}], ",", "6000"}], "]"}], ",", "wp"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"vals", "=", 
     RowBox[{"detEnd", "/@", "grid"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"crossings", "=", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"grid", ",", "vals"}], "}"}], "]"}], ",", "2", ",", "1"}], 
        "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "<", "0"}], "&"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"crossings", "===", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{
       RowBox[{"Print", "[", "\"\<No sign-changing zero found.\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"bracket", "=", 
     RowBox[{
      RowBox[{"First", "[", "crossings", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tcon", "=", 
     RowBox[{"t", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"detEnd", "[", "t", "]"}], "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"bracket", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"bracket", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"WorkingPrecision", "->", "wp"}], ",", 
        RowBox[{"AccuracyGoal", "->", "25"}], ",", 
        RowBox[{"PrecisionGoal", "->", "25"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "Output"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<First conjugate time = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{"tcon", ",", "16"}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<t_con/P = \>\"", ",", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"tcon", "/", "P"}], ",", "16"}], "]"}]}], "]"}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"Print", "[", 
