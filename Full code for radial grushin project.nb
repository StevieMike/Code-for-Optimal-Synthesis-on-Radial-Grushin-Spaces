Cell[BoxData[
 RowBox[{"\n", "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tol", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MakePair", "[", 
      RowBox[{"K_", ",", "w_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"L2", "=", 
         RowBox[{"1", "-", 
          RowBox[{"K", "^", "2"}], "-", 
          RowBox[{"w", "^", "2"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"L2", "<=", "0"}], ",", 
          RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sqrt", "[", "L2", "]"}], ",", "K", ",", "w"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", "L2", "]"}]}], ",", "K", ",", "w"}], 
           "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PiAlpha", "[", "alpha_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Beta", "[", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "alpha"}], ")"}]}], ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], "/", "alpha"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9983565194824944`*^9, 3.998356519482606*^9}, {
  3.9983569029529943`*^9, 3.998356930030759*^9}},
 CellLabel->
  "In[3934]:=",ExpressionUUID->"e78e4d6b-a667-41ef-8ada-9cfb75a2bd53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "TurningRadii", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TurningRadii", "[", 
    RowBox[{
     RowBox[{"alpha_", "?", "NumericQ"}], ",", 
     RowBox[{"{", 
      RowBox[{"L_", ",", "K_", ",", "w_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"kk", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", "K", "]"}], "]"}]}], ",", 
       RowBox[{"ww", "=", 
        RowBox[{"Abs", "[", 
         RowBox[{"N", "[", "w", "]"}], "]"}]}], ",", "rc", ",", "q", ",", 
       "hi", ",", "rm", ",", "rp"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ww", "<", "tol"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "Infinity"}], "}"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"kk", "<", "tol"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"0.", ",", 
           RowBox[{"ww", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "/", "alpha"}], ")"}]}]}], "}"}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"r_", "?", "NumericQ"}], "]"}], ":=", 
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"kk", "^", "2"}], "/", 
         RowBox[{"r", "^", "2"}]}], "-", 
        RowBox[{
         RowBox[{"ww", "^", "2"}], " ", 
         RowBox[{"r", "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", "alpha"}], ")"}]}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rc", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kk", "^", "2"}], "/", 
          RowBox[{"(", 
           RowBox[{"alpha", " ", 
            RowBox[{"ww", "^", "2"}]}], ")"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "alpha"}], "+", "2"}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Circular", " ", "orbit"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"q", "[", "rc", "]"}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "9"}]}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"{", 
          RowBox[{"rc", ",", "rc"}], "}"}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hi", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"2", " ", "rc"}], ",", 
         RowBox[{"2", " ", 
          RowBox[{"ww", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "/", "alpha"}], ")"}]}]}], ",", "2."}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"q", "[", "hi", "]"}], ">", "0"}], ",", 
        RowBox[{"hi", "*=", "2"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"rm", "=", 
       RowBox[{"r", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "[", "r", "]"}], "==", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", 
            RowBox[{"rc", " ", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}], ",", "rc"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rp", "=", 
       RowBox[{"r", "/.", " ", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"q", "[", "r", "]"}], "==", "0"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "rc", ",", "hi"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<Brent\>\""}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"rm", ",", "rp"}], "}"}]}]}], "]"}]}], ";"}]}], "Input",
